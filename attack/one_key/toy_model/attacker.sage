"""Recover the other paper-example secret after K1 is leaked.

Run from the repository root:
    sage attack/one_key/toy_model/attacker.sage

The simulated leaked K1 is 8 for the bundled toy demonstration.
To use a different compromised key, edit LEAKED_K1 below.

The attacker reads public_values.txt and the one compromised key K1.
It does not need Q, curve points, participant shares, or dealer state.
"""

import sys
from pathlib import Path

from sage.all import GF, PolynomialRing, ZZ

# Fixed simulated leak and script-relative public transcript.
LEAKED_K1 = 8
PUBLIC_FILE = Path(sys.argv[0]).resolve().with_name("public_values.txt")

# Use the exact field and curve-extension polynomial used by the toy masking experiments.
F47 = GF(47)
R = PolynomialRing(F47, "X")
X = R.gen()
Fqk = F47.extension(X**3 + 3*X + 42, "alpha")
alpha = Fqk.gen()


def decode_field_element(line):
    """Convert comma-separated coefficients into an element of F_(47^3)."""
    coefficients = [ZZ(c.strip()) for c in line.split(",")]
    value = Fqk(0)
    for i, coefficient in enumerate(coefficients):
        value += Fqk(coefficient) * alpha**i
    return value


if not 0 <= LEAKED_K1 < 47:
    raise ValueError("K1 must be an integer in the range 0 through 46.")

# Read only the two public values generated by dealer.sage.
lines = [line.strip() for line in PUBLIC_FILE.read_text().splitlines() if line.strip()]
if len(lines) < 2:
    raise ValueError("public_values.txt must contain v1 and v2.")
v1, v2 = [decode_field_element(line) for line in lines[:2]]

# Since v1 = z + K1 and K1 is now known, recover z directly.
# This attack does not need the Frobenius calculation from the first attack.
z = v1 - Fqk(LEAKED_K1)

# The mask should be in the public order-37 pairing subgroup.
if z**37 != 1:
    raise ValueError("The supplied leaked K1 does not produce a valid mask.")

# Recover the keys using Ki = vi - z^i.
K1 = v1 - z
K2 = v2 - z**2

# Each secret must lie in the base field F47.
if K1**47 != K1 or K2**47 != K2:
    raise ValueError("A recovered key is not in the expected base field F47.")
if K1 != Fqk(LEAKED_K1):
    raise ValueError("The supplied leaked key did not match the first public value.")

print("Recovered z using leaked K1 and public v1.")
print("Recovered K1 =", K1)
print("Recovered K2 =", K2)
